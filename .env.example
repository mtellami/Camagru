APP_URL=http://localhost:8080
APP_PORT=8080
MAILPIT_PORT=8025
# Enable the local Mailpit service. Leave empty when using an external SMTP server.
COMPOSE_PROFILES=dev
DB_HOST=db
DB_PORT=5432
DB_NAME=camagru
DB_USER=camagru
DB_PASSWORD=GENERATE_ME
APP_KEY=GENERATE_ME
COOKIE_SECURE=0
MAIL_FROM="Camagru Accounts <no-reply@camagru.app>"
SMTP_HOST=mailpit
SMTP_PORT=1025
# none (local development), starttls (usually 587), or tls (usually 465).
SMTP_ENCRYPTION=none
# Leave both empty for an SMTP server without authentication.
SMTP_USER=
SMTP_PASSWORD=
# Envelope sender; use an address authorized by your SMTP provider.
SMTP_FROM=no-reply@camagru.app
